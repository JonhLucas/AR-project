# This .gitignore file should be placed at the root of your Unity project directory 
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#

src/AR-project/.vscode
src/AR-project/.utmp/
src/AR-project/[Ll]ibrary/
src/AR-project/[Tt]emp/
src/AR-project/[Oo]bj/
src/AR-project/[Bb]uild/
src/AR-project/[Bb]uilds/
src/AR-project/[Ll]ogs/
src/AR-project/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
src/AR-project/[Mm]emoryCaptures/

# Recordings can get excessive in size
src/AR-project/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# src/AR-project/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
src/AR-project/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
src/AR-project/.vs/

# Gradle cache directory
src/AR-project/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
src/AR-project/ExportedObj/
src/AR-project/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
src/AR-project/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
src/AR-project/[Aa]ssets/[Ss]treamingAssets/aa.meta
src/AR-project/[Aa]ssets/[Ss]treamingAssets/aa/*